{
  "name": "tw-quant-daybrain",
  "version": "0.1.0",
  "description": "台股當沖 DayBrain — 盤前/盤中/盤後自動化交易決策引擎（TypeScript）",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:simulate": "node --import tsx src/simulate/cli.ts",
    "test:simulate:unit": "node --test --import tsx --test-concurrency=1 \"src/simulate/*.test.ts\"",
    "lint": "tsc --noEmit -p tsconfig.json && eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "stress": "tsx src/ops/stress_cli.ts",
    "experiment": "tsx src/ops/experiment_cli.ts",
    "grid-search": "tsx src/backtest/grid_search_cli.ts",
    "wfo": "tsx src/backtest/wfo_cli.ts"
  },
  "keywords": [
    "trading",
    "day-trading",
    "twse",
    "mcp",
    "typescript"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0"
  }
}